{
  "name": "arenahub",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs",
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @arenahub/api db:migrate",
    "db:seed": "pnpm --filter @arenahub/api db:seed",
    "db:studio": "pnpm --filter @arenahub/api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10"
  }
}
