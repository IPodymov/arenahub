{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @arenahub/shared build && pnpm --filter @arenahub/web build"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "pnpm --filter @arenahub/shared build && pnpm --filter @arenahub/api build && pnpm --filter @arenahub/api exec prisma migrate deploy && pnpm --filter @arenahub/api exec node scripts/bundle.mjs",
      "outputDirectory": "vercel-dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
