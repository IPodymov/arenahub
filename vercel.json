{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @arenahub/shared build && pnpm --filter @arenahub/web build"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "buildCommand": "pnpm --filter @arenahub/shared build && pnpm --filter @arenahub/api exec prisma migrate deploy && pnpm --filter @arenahub/api build"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
