# ── Общие ───────────────────────────────────────────────
NODE_ENV=development

# ── API ─────────────────────────────────────────────────
# Порты контейнеров на хосте (docker-compose)
POSTGRES_PORT=55432
REDIS_PORT=56379

API_PORT=4000
DATABASE_URL=postgresql://arenahub:arenahub@localhost:55432/arenahub
# Используется только e2e-тестами (БД создаётся docker-compose автоматически)
TEST_DATABASE_URL=postgresql://arenahub:arenahub@localhost:55432/arenahub_test
REDIS_URL=redis://localhost:56379
# Не короче 32 символов. В production значение из этого файла запрещено.
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef

# Публичный адрес веба. API проксируется через него (/api/*), поэтому cookie и
# Steam OpenID realm живут на одном origin.
WEB_ORIGIN=http://localhost:3000

# Ключ: https://steamcommunity.com/dev/apikey. Без ключа вход через Steam выключен.
STEAM_API_KEY=
# steamid64 через запятую — получают роль admin при входе
ADMIN_STEAM_IDS=
# Никнеймы через запятую — получают роль admin при регистрации/входе по паролю
ADMIN_NICKNAMES=

# Вход без Steam (только development/test, в production запрещён валидацией)
AUTH_DEV_LOGIN=false

# ── Web ─────────────────────────────────────────────────
# Куда Next.js проксирует /api/* (адрес API изнутри)
API_INTERNAL_URL=http://localhost:4000
